flowchart TB
  %% Advanced flowchart: subgraphs for stages, edge labels for conditions.
  %% No emoji, no inline colors — presentation belongs to the render preset.
    start((Start))

    subgraph prep[Prepare]
        direction LR
        input[/Read config/]
        validate{Validate}
        parse[Parse params]
    end

    subgraph sql[Build query]
        direction TB
        template[Load template]
        replace[Bind params]
        optimize[Optimize]
    end

    subgraph exec[Execute]
        direction LR
        cache{Cache hit?}
        execute[Run query]
        warehouse[(Warehouse)]
    end

    subgraph output[Publish]
        direction TB
        format[Format rows]
        save[Write JSON]
        convert[Write CSV]
        report[Report]
    end

    start --> input
    input --> validate
    validate -->|valid| parse
    validate -->|invalid| failure[Handle error]
    failure --> start

    parse --> template
    template --> replace
    replace --> optimize
    optimize --> cache

    cache -->|yes| format
    cache -->|no| execute
    execute --> warehouse
    warehouse --> format

    format --> save
    save --> convert
    convert --> report
    report --> done((Done))
