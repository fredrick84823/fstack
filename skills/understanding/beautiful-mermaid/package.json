{
  "name": "beautiful-mermaid-skill",
  "private": true,
  "version": "2.0.0",
  "description": "Skill wrapper around beautiful-mermaid: Craft-style diagram rendering",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "bootstrap": "node scripts/setup_check.js --install",
    "check": "node scripts/setup_check.js",
    "render": "node scripts/render_mermaid.js",
    "build:showcase": "node scripts/build_showcase.js && node scripts/build_embedded_showcase.js",
    "test": "node --test \"tests/*.test.js\"",
    "test:update-baselines": "BM_UPDATE_BASELINES=1 node --test \"tests/*.test.js\""
  },
  "dependencies": {
    "beautiful-mermaid": "1.1.3"
  }
}
